# ==============================================================================
# @angelitosystems/nest-auth Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables according to your environment.
# Never commit real secrets to version control.

# --- Application ---
NODE_ENV=development
PORT=3000

# --- Database Connections (Configure for your selected adapter) ---
# PostgreSQL (Prisma or TypeORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest_auth_dev?schema=public

# MySQL (TypeORM or Sequelize)
MYSQL_URL=mysql://root:rootpassword@localhost:3306/nest_auth_dev

# MongoDB (Mongoose)
MONGODB_URI=mongodb://localhost:27017/nest_auth_dev

# --- Authentication & JWT ---
# Secret must be at least 32 characters in production. Generate with: openssl rand -hex 32
AUTH_JWT_SECRET=change-me-to-a-secure-random-32-byte-hex-string-for-production
AUTH_ACCESS_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
AUTH_JWT_ISSUER=https://auth.angelitosystems.com
AUTH_JWT_AUDIENCE=https://api.angelitosystems.com

# --- Cookies (HttpOnly / Secure) ---
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_MAX_AGE=900000

# --- Multi-Device Sessions ---
AUTH_SESSIONS_ENABLED=true
AUTH_MAX_CONCURRENT_SESSIONS=5
AUTH_SESSION_TRACK_DEVICE=true

# --- Two-Factor Authentication (TOTP) ---
AUTH_2FA_ISSUER=AngelitoSystemsAuth
AUTH_2FA_WINDOW=1

# --- Mail Provider (Email Verification & Password Reset) ---
# Available providers: console (dev), smtp, resend, sendgrid
AUTH_MAIL_PROVIDER=console
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@angelitosystems.com

# --- Audit Logs ---
AUTH_AUDIT_LOGS_ENABLED=true

# --- Database Seed (Initial Administrator) ---
AUTH_SEED_ADMIN_EMAIL=admin@angelitosystems.com
AUTH_SEED_ADMIN_PASSWORD=AdminSecurePassword123!
